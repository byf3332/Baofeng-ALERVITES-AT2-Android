<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pttPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B2A31"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/tvPttHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/ptt_status_ready"
        android:textColor="#D1D5DB"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/pttDisplayCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_ptt_display"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="18dp"
        android:paddingEnd="26dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tvPttChannelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_channel_1"
            android:textColor="#235C18"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPttFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="-0.02"
            android:text="@string/read_write_unknown_frequency"
            android:textColor="#071404"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPttSubState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ptt_ready_text"
            android:textColor="#3B7A2A"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPttPrevChannel"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_ptt_round_button"
            android:gravity="center"
            android:text="@string/common_minus_symbol"
            android:textColor="#D1D5DB"
            android:textSize="34sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnPttNextChannel"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_ptt_round_button"
            android:gravity="center"
            android:text="@string/common_plus_fullwidth_symbol"
            android:textColor="#D1D5DB"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pttPressArea"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_ptt_press_button"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvPttState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ptt_label"
            android:textColor="#E5E7EB"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
