<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="7dp">

    <LinearLayout
        android:id="@+id/leftGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLeftAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_teal"
            android:gravity="center"
            android:text="@string/chat_receiver_avatar_placeholder"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLeftSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_other_label"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/leftBubbleContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:id="@+id/leftBubble"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_bubble_other"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/tvLeftTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="210dp"
                            android:textColor="#111827"
                            android:textIsSelectable="true"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/viewLeftImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:adjustViewBounds="true"
                            android:background="#E5E7EB"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvLeftBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxWidth="210dp"
                            android:textColor="#2563EB"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />
                    </LinearLayout>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/leftPendingContainer"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="-14dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressLeftPending"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="false"
                        android:max="100"
                        app:indicatorColor="#4F8CFF"
                        app:indicatorSize="28dp"
                        app:indicatorInset="0dp"
                        app:indicatorDirectionCircular="clockwise"
                        app:indicatorTrackGapSize="0dp"
                        app:trackCornerRadius="3dp"
                        app:trackColor="#E6EEF9"
                        app:trackThickness="4dp" />
                </FrameLayout>

                <View
                    android:id="@+id/leftUnreadDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="-8dp"
                    android:background="@drawable/bg_unread_dot_red"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rightBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginStart="52dp"
                    android:background="@drawable/bg_bubble_self"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvRightTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="210dp"
                        android:textColor="#111827"
                        android:textIsSelectable="true"
                        android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/viewRightImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:adjustViewBounds="true"
                            android:background="#E5E7EB"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRightBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxWidth="210dp"
                        android:textColor="#2563EB"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/rightPendingContainer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressRightPending"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:indeterminate="false"
                        android:max="100"
                        app:indicatorColor="#4F8CFF"
                        app:indicatorDirectionCircular="clockwise"
                        app:indicatorInset="0dp"
                        app:indicatorSize="44dp"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="#E8F0FE"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="4dp" />

                    <TextView
                        android:id="@+id/tvRightPendingPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/chat_receiving_progress_zero"
                        android:textColor="#3F3F46"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRightAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_round_gold"
            android:gravity="center"
            android:text="@string/chat_self_label"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
